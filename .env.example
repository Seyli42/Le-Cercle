# ============================================================================
# Le Cercle — variables d'environnement
# Copiez ce fichier en ".env" (jamais commité) puis remplissez les valeurs.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) PUBLIQUES — intégrées dans l'app (préfixe EXPO_PUBLIC_).
#    Lisibles par n'importe qui qui télécharge l'app : AUCUN secret ici.
# ---------------------------------------------------------------------------
# development | preview | production
EXPO_PUBLIC_APP_ENV=development
# Sentry > Settings > Projects > [projet] > Client Keys (DSN). Obligatoire en production.
EXPO_PUBLIC_SENTRY_DSN=
# Supabase > Project Settings > API Keys : URL du projet + clé "Publishable" (sb_publishable_…)
# ou, sur les anciens projets, la clé "anon". Publique par conception : les données sont
# protégées par les règles RLS. JAMAIS la clé "secret" / "service_role" ici.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compte de démonstration des vérificateurs Apple / Google (adresse seule, JAMAIS le mot
# de passe). Seule cette adresse voit un champ mot de passe. Voir docs/PUBLICATION.md.
EXPO_PUBLIC_REVIEW_EMAIL=
# Monétisation (docs/MONETISATION.md). Hors production, les pubs de TEST de Google sont
# utilisées automatiquement : laissez vide pour développer.
# RevenueCat > Project > API keys : clés PUBLIQUES par plateforme (appl_… / goog_…).
# JAMAIS la clé secrète (sk_…).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# AdMob > Applications > Blocs d'annonces : identifiants ca-app-pub-…/… (avec une barre « / »).
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# ---------------------------------------------------------------------------
# 2) BUILD — utilisées par EAS au moment de compiler, jamais dans l'app.
#    À déclarer dans EAS (expo.dev > projet > Environment variables, visibilité "Secret").
# ---------------------------------------------------------------------------
APP_VARIANT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# AdMob > Applications > Paramètres : ID d'APPLICATION ca-app-pub-…~… (avec un « ~ »).
# Vide = ID de démonstration de Google (pubs de test uniquement).
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# ---------------------------------------------------------------------------
# 3) SERVEUR — uniquement dans les Supabase Edge Functions.
#    À déclarer avec : npx supabase secrets set NOM=valeur
#    NE JAMAIS les préfixer par EXPO_PUBLIC_ ni les mettre dans l'app.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY est fourni automatiquement aux Edge Functions.
# Clé Anthropic (console.anthropic.com) pour la lecture des ordonnances (étape 7).
ANTHROPIC_API_KEY=
# Twilio : un numéro capable de RECEVOIR des SMS (réponses OUI / STOP des proches),
# ou un Messaging Service qui en contient un.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Facultatif : URL exacte du webhook configurée chez Twilio (sinon déduite du projet).
TWILIO_WEBHOOK_URL=
# Secret partagé avec la tâche planifiée pg_cron (supabase/setup/cron.sql).
# Générez-le avec : openssl rand -hex 32
CRON_SECRET=
# RevenueCat > Project > API keys > Secret key : efface l'historique d'achat à la
# suppression d'un compte (RGPD). Facultatif.
REVENUECAT_SECRET_API_KEY=
