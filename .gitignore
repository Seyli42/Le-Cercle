# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Secrets
.env
.env.*
!.env.example

# Tests
coverage/

# Native build outputs of local modules
modules/*/android/build/
modules/*/android/.gradle/
modules/*/ios/build/

# Deno lockfile created if Deno is ever run from the root (use npm run *:functions)
/deno.lock

# Store credentials (Google Play service account, App Store Connect key): never committed
/secrets/
*.p8

# Generated website (npm run website:build)
/website/dist/

# Firebase service account (secret, uploaded to EAS only). google-services.json is public.
*firebase-adminsdk*.json
