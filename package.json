{
  "name": "le-cercle",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-purchases": "^10.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "reminder-health": "file:./modules/reminder-health"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "doctor": "npx expo-doctor@latest",
    "test:db": "./scripts/test-db.sh",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "test:functions": "cd supabase/functions && deno test --allow-env",
    "check:functions": "cd supabase/functions && deno check */index.ts",
    "functions:deploy": "supabase functions deploy",
    "icons": "node scripts/generate-icons.mjs",
    "website:build": "node scripts/build-website.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^reminder-health$": "<rootDir>/modules/reminder-health/src"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/supabase/"
    ],
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
